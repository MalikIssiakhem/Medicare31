# =============================================================================
# Medicare31 — exemple de variables d'environnement
# =============================================================================
# Copier ce fichier en ".env" à la racine du projet, puis adapter les valeurs :
#   cp .env.example .env
#
# IMPORTANT : ces variables sont injectées dans le conteneur "backend" par
# docker-compose.yml. NE JAMAIS commit le vrai .env (il est listé dans
# .gitignore). Les valeurs sensibles (clés API, mots de passe SMTP, ...) ne
# doivent jamais apparaître dans ce fichier d'exemple.
# =============================================================================


# -----------------------------------------------------------------------------
# Base de données PostgreSQL
# -----------------------------------------------------------------------------
postgres_user=medicare
postgres_password=medicare_pass
postgres_db=medicaredb

# URL complète utilisée par SQLAlchemy. Le nom d'hôte "db" correspond au
# service Docker "db" défini dans docker-compose.yml — NE PAS mettre
# "localhost" ici, cela ne fonctionnerait pas depuis l'intérieur du conteneur.
database_url=postgresql://medicare:medicare_pass@db:5432/medicaredb


# -----------------------------------------------------------------------------
# Authentification JWT
# -----------------------------------------------------------------------------
# Clé utilisée pour signer les tokens JWT. DOIT être remplacée par une valeur
# aléatoire d'au moins 32 caractères en production :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
secret_key=changez-cette-cle-en-production-minimum-32-caracteres
algorithm=HS256
access_token_expire_minutes=60


# -----------------------------------------------------------------------------
# SMTP — envoi d'emails transactionnels
# -----------------------------------------------------------------------------
# Le backend Medicare31 envoie trois types d'emails :
#   - vérification d'adresse après inscription
#   - réinitialisation de mot de passe
#   - confirmation de modification de mot de passe
#
# Pour tester en local, on utilise MailHog (conteneur Docker fourni dans
# docker-compose.yml) : il capture TOUS les emails sortants et les expose
# sur http://localhost:8025 — aucune inscription chez un fournisseur tiers
# n'est nécessaire.
#
# En production, remplacer par un vrai fournisseur SMTP (Brevo, SendGrid,
# Gmail SMTP, OVH, Mailgun, etc.) et fournir ses identifiants.

# --- Mode développement (par défaut) : MailHog ---
smtp_host=mailhog
smtp_port=1025
smtp_from=noreply@medicare31.fr
smtp_user=
smtp_password=
smtp_use_tls=false

# --- Mode production : Brevo (ex-Sendinblue) ---
# Créer un compte sur https://www.brevo.com, puis :
#   1. Settings → SMTP & API → SMTP Tokens
#   2. Générer un nouveau token
#   3. Copier le "Login" (souvent une adresse @smtp-brevo.com) et la clé ici.
# smtp_host=smtp-relay.brevo.com
# smtp_port=587
# smtp_from=noreply@votredomaine.fr
# smtp_user=votre-login@smtp-brevo.com
# smtp_password=xsmtpsib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# smtp_use_tls=true

# --- Mode production : Gmail SMTP ---
# Gmail n'autorise plus les "mots de passe d'application" simples. Il faut :
#   1. Activer la validation en deux étapes sur le compte Google.
#   2. Créer un "App Password" sur https://myaccount.google.com/apppasswords
#   3. Utiliser ce mot de passe à 16 caractères ici (sans espaces).
# smtp_host=smtp.gmail.com
# smtp_port=587
# smtp_from=votre.adresse@gmail.com
# smtp_user=votre.adresse@gmail.com
# smtp_password=xxxxxxxxxxxxxxxx
# smtp_use_tls=true

# Optionnel : destinataire utilisé par scripts/diagnose_smtp.py pour son
# email de test. Par défaut, il utilise SMTP_USER.
# smtp_test_to=test@votredomaine.fr


# -----------------------------------------------------------------------------
# URLs de l'application
# -----------------------------------------------------------------------------
# URL de base utilisée pour générer les liens dans les emails (ex. lien de
# vérification d'adresse : http://localhost/api/auth/verify-email?token=...).
app_base_url=http://localhost

# URL du frontend, utilisée pour générer les liens de réinitialisation de mot
# de passe (le front sert la page reset-password.html).
frontend_base_url=http://localhost


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Niveau de log global du backend (DEBUG / INFO / WARNING / ERROR).
# INFO est le défaut — DEBUG est très bavard (affiche chaque requête SQL).
log_level=INFO
